# ==============================================================================
# GamePanel Lite 环境变量配置示例
# 使用方法：cp .env.example .env 并按需修改（或运行 ./install.sh 自动生成随机密钥）
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Web 访问入口与默认安全绑定
# ------------------------------------------------------------------------------
# Web 控制台对外监听地址与端口（默认对所有网卡开放 3000 端口）
GP_WEB_BIND_IP=0.0.0.0
GP_WEB_PORT=3000

# 内部基础组件（Postgres / Redis / NATS / API / SeaweedFS / Prometheus）默认仅绑定 127.0.0.1，
# 防止在公网云服务器上意外暴露内部端口；如确需局域网跨机器调试再改为 0.0.0.0。
GP_BIND_IP=127.0.0.1
GP_APISERVER_PORT=8080
GP_AGENT_PORT=8082
GP_POSTGRES_PORT=5432
GP_REDIS_PORT=6379
GP_NATS_PORT=4222
GP_NATS_MONITOR_PORT=8222
GP_SEAWEEDFS_S3_PORT=8333
GP_SEAWEEDFS_MASTER_PORT=9333
GP_SEAWEEDFS_ADMIN_PORT=23646
GP_PROMETHEUS_PORT=9090

# ------------------------------------------------------------------------------
# 2. 初始管理员账号（首次启动数据库初始化时生效）
# ------------------------------------------------------------------------------
GP_BOOTSTRAP_ADMIN=admin
GP_BOOTSTRAP_EMAIL=admin@example.com
# 请在首次部署前修改为强密码，或通过 ./install.sh 自动生成
GP_BOOTSTRAP_PASSWORD=ChangeMe!2026

# ------------------------------------------------------------------------------
# 3. 安全密钥与数据库凭据（生产环境务必替换为高强度随机值）
# ------------------------------------------------------------------------------
GP_AUTH_JWT_SECRET=please-change-jwt-secret-to-random-hex
GP_AGENT_TOKEN=please-change-agent-token-to-random-hex
GP_REGISTRY_WORKER_TOKEN=please-change-registry-worker-token

POSTGRES_USER=gamepanel
POSTGRES_PASSWORD=please-change-postgres-password
POSTGRES_DB=gamepanel

# 默认对象存储 SeaweedFS S3 凭据：如需修改 GP_S3_ACCESS_KEY / GP_S3_SECRET_KEY，
# 请同步更新 deploy/seaweedfs/s3.json 中对应的 accessKey 与 secretKey。
GP_S3_ACCESS_KEY=gamepanel
GP_S3_SECRET_KEY=gamepanel123
GP_S3_BUCKET=gamepanel-backups
SEAWEEDFS_ADMIN_PASSWORD=please-change-seaweedfs-admin-password

# ------------------------------------------------------------------------------
# 4. 游戏节点网络、端口池与存储路径
# ------------------------------------------------------------------------------
# 节点公网/域名展示地址（留空则自动探测网卡 IP；如有域名如 play.example.com 可在此显式指定）
GP_AGENT_EXTERNAL_IP=
# 节点内网地址（留空则自动探测私有网卡 IP）
GP_AGENT_INTERNAL_IP=

# 游戏容器动态端口分配范围（请同步在云服务器安全组/防火墙放行此范围的 TCP 与 UDP）
GP_NETWORK_PORT_RANGE_MIN=20000
GP_NETWORK_PORT_RANGE_MAX=29999

# 游戏实例存档、Mod 与服务端缓存宿主机目录
GP_AGENT_WORK_DIR=/var/lib/gamepanel/instances

# 单机版可选资源预留（例如 500m / 512Mi；留空则按宿主机实测可用量上报）
GP_AGENT_RESERVED_CPU=
GP_AGENT_RESERVED_MEMORY=

# ------------------------------------------------------------------------------
# 5. Steam 创意工坊与上游加速代理（可选）
# ------------------------------------------------------------------------------
# Steam Web API Key（申请地址：https://steamcommunity.com/dev/apikey）
# 配置后可在创意工坊弹窗中按「最多订阅 / 近期热门 / 关键词」浏览与搜索模组；
# 未配置时仍可通过「直接粘贴创意工坊单品或合集链接」免 Key 安装模组。
STEAM_WEB_API_KEY=

# 访问 GitHub / PaperMC / Modrinth / Steam 等上游源的 HTTP(S) 出站代理（如有需要可填写）
# 例如：http://127.0.0.1:7890
GP_AGENT_UPSTREAM_PROXY=
GP_AGENT_DOWNLOAD_PROXY=

# ------------------------------------------------------------------------------
# 6. 镜像仓库与版本标签
# ------------------------------------------------------------------------------
GP_IMAGE_REGISTRY=registry.cn-hangzhou.aliyuncs.com/gamepanel-lite
GP_IMAGE_TAG=v2.0.0
