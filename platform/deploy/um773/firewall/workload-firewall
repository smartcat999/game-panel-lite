#!/bin/sh
set -eu

network=${GAMEPANEL_WORKLOAD_NETWORK:-gamepanel-workloads}
chain=GAMEPANEL-EGRESS
iptables=iptables-legacy

subnet() {
  docker network inspect "$network" --format '{{(index .IPAM.Config 0).Subnet}}'
}

apply() {
  source_subnet=$(subnet)
  "$iptables" -N "$chain" 2>/dev/null || true
  "$iptables" -C DOCKER-USER -s "$source_subnet" -j "$chain" 2>/dev/null || "$iptables" -I DOCKER-USER 1 -s "$source_subnet" -j "$chain"
  "$iptables" -F "$chain"
  "$iptables" -A "$chain" -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
  old_ifs=$IFS
  IFS=,
  for destination in ${GAMEPANEL_MANAGEMENT_CIDRS}; do
    "$iptables" -A "$chain" -d "$destination" -j REJECT
  done
  IFS=$old_ifs
  "$iptables" -A "$chain" -j RETURN
}

check() {
  source_subnet=$(subnet)
  "$iptables" -C DOCKER-USER -s "$source_subnet" -j "$chain" >/dev/null 2>&1
  old_ifs=$IFS
  IFS=,
  for destination in ${GAMEPANEL_MANAGEMENT_CIDRS}; do
    "$iptables" -C "$chain" -d "$destination" -j REJECT >/dev/null 2>&1
  done
  IFS=$old_ifs
}

case "${1:-run}" in
  check) check ;;
  run)
    while true; do
      apply
      sleep 30
    done
    ;;
  *) exit 64 ;;
esac
