{
  "openapi": "3.1.0",
  "info": {"title": "GamePanel Platform and Region Operations API", "version": "1.0.0"},
  "servers": [{"url": "/api"}],
  "paths": {
    "/v1/platform/users": {"get": {"operationId": "listPlatformUsers", "responses": {"200": {"description": "Users"}}}, "post": {"operationId": "createLocalUser", "requestBody": {"$ref": "#/components/requestBodies/CreateLocalUser"}, "responses": {"201": {"description": "Local user with one-time password"}}}},
    "/v1/platform/workspaces": {"get": {"operationId": "listPlatformWorkspaces", "responses": {"200": {"description": "Workspaces"}}}},
    "/v1/platform/invitations": {"post": {"operationId": "createPlatformInvitation", "responses": {"202": {"$ref": "#/components/responses/Accepted"}}}},
    "/v1/platform/credit-grants": {"post": {"operationId": "grantPromotionalCredit", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/PromotionalCreditGrant"}, "responses": {"201": {"description": "Promotional credit ledger entry committed"}}}},
    "/v1/platform/price-books": {"get": {"operationId": "listPriceBooks", "responses": {"200": {"description": "Price books"}}}, "post": {"operationId": "createPriceBookRevision", "requestBody": {"$ref": "#/components/requestBodies/PriceBookRevision"}, "responses": {"201": {"description": "Immutable price book revision published"}}}},
    "/v1/platform/region-catalogs": {"post": {"operationId": "createRegionCatalogRevision", "requestBody": {"$ref": "#/components/requestBodies/RegionCatalogRevision"}, "responses": {"201": {"description": "Region resource catalog revision published"}}}},
    "/v1/platform/instances": {"get": {"operationId": "listPlatformInstances", "responses": {"200": {"description": "Cross-workspace instance inventory"}}}},
    "/v1/platform/regions": {"get": {"operationId": "listPlatformRegions", "responses": {"200": {"description": "Regions"}}}},
    "/v1/platform/regions/{regionId}": {"get": {"operationId": "getPlatformRegion", "parameters": [{"$ref": "#/components/parameters/RegionId"}], "responses": {"200": {"description": "Region"}}}, "patch": {"operationId": "updatePlatformRegionOperations", "parameters": [{"$ref": "#/components/parameters/RegionId"}], "responses": {"200": {"description": "Region updated"}}}},
    "/v1/platform/audit-events": {"get": {"operationId": "listPlatformAuditEvents", "responses": {"200": {"description": "Audit events"}}}},
    "/v1/regions/{regionId}/health": {"get": {"operationId": "getRegionHealth", "parameters": [{"$ref": "#/components/parameters/RegionId"}], "responses": {"200": {"description": "Region health"}}}},
    "/v1/regions/{regionId}/nodes": {"get": {"operationId": "listRegionNodes", "parameters": [{"$ref": "#/components/parameters/RegionId"}], "responses": {"200": {"description": "Nodes"}}}},
    "/v1/regions/{regionId}/deployments": {"get": {"operationId": "listRegionalDeployments", "parameters": [{"$ref": "#/components/parameters/RegionId"}], "responses": {"200": {"description": "Deployments"}}}},
    "/v1/regions/{regionId}/tasks": {"get": {"operationId": "listRegionalTasks", "parameters": [{"$ref": "#/components/parameters/RegionId"}], "responses": {"200": {"description": "Durable tasks"}}}},
    "/v1/regions/{regionId}/tasks/{taskId}:retry": {"post": {"operationId": "retryRegionalTask", "parameters": [{"$ref": "#/components/parameters/RegionId"}, {"name": "taskId", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"202": {"$ref": "#/components/responses/Accepted"}}}},
    "/v1/regions/{regionId}/capacity": {"get": {"operationId": "getRegionCapacity", "parameters": [{"$ref": "#/components/parameters/RegionId"}], "responses": {"200": {"description": "Capacity"}}}},
    "/v1/regions/{regionId}/storage": {"get": {"operationId": "getRegionStorage", "parameters": [{"$ref": "#/components/parameters/RegionId"}], "responses": {"200": {"description": "Storage"}}}},
    "/v1/regions/{regionId}/monitoring": {"get": {"operationId": "getRegionMonitoring", "parameters": [{"$ref": "#/components/parameters/RegionId"}], "responses": {"200": {"description": "Monitoring"}}}},
    "/v1/regions/{regionId}/deployments/{deploymentId}:override-placement": {"post": {"operationId": "overrideRegionalPlacement", "parameters": [{"$ref": "#/components/parameters/RegionId"}, {"name": "deploymentId", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"202": {"$ref": "#/components/responses/Accepted"}}}}
  },
  "components": {
    "requestBodies": {
      "CreateLocalUser": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["username", "displayName", "oneTimePassword"], "properties": {"username": {"type": "string", "minLength": 3, "maxLength": 64}, "displayName": {"type": "string", "minLength": 1, "maxLength": 80}, "oneTimePassword": {"type": "string", "format": "password", "minLength": 12}}}}}},
      "PromotionalCreditGrant": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PromotionalCreditGrant"}}}},
      "PriceBookRevision": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PriceBookRevision"}}}},
      "RegionCatalogRevision": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RegionCatalogRevision"}}}}
    },
    "parameters": {
      "RegionId": {"name": "regionId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^reg_[A-Za-z0-9]+$"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 8, "maxLength": 128}}
    },
    "responses": {
      "Accepted": {
        "description": "Durable operation accepted",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OperationReference"}}}
      }
    },
    "schemas": {
      "BuiltInRole": {"type": "string", "enum": ["platform.admin", "region.operator", "workspace.owner", "workspace.operator", "workspace.viewer"]},
      "OperationReference": {"type": "object", "additionalProperties": false, "required": ["id", "status"], "properties": {"id": {"type": "string"}, "status": {"type": "string", "enum": ["queued", "running", "succeeded", "failed"]}}},
      "PromotionalCreditGrant": {"type": "object", "additionalProperties": false, "required": ["workspaceId", "currency", "amountMinor", "reason"], "properties": {"workspaceId": {"type": "string"}, "currency": {"const": "CNY"}, "amountMinor": {"type": "integer", "minimum": 1}, "reason": {"type": "string", "minLength": 1, "maxLength": 160}}},
      "PriceBookRevision": {
        "type": "object",
        "additionalProperties": false,
        "required": ["regionId", "revision", "currency", "effectiveAt", "unitPrices"],
        "properties": {
          "regionId": {"type": "string"},
          "revision": {"type": "integer", "minimum": 1},
          "currency": {"const": "CNY"},
          "effectiveAt": {"type": "string", "format": "date-time"},
          "unitPrices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
                "required": ["resourceKind", "priceMinor", "unitQuantity", "unit"],
              "properties": {
                "resourceKind": {"type": "string", "enum": ["cpu", "memory", "instance-disk", "backup-storage", "dedicated-ip"]},
                  "priceMinor": {"type": "integer", "minimum": 0},
                  "unitQuantity": {"type": "integer", "minimum": 1},
                "unit": {"type": "string"}
              }
            }
          }
        }
      },
      "RegionCatalogRevision": {"type": "object", "additionalProperties": false, "required": ["regionId", "version", "cpu", "memory", "disk", "dedicatedIpAvailable", "endpointDeliveryModes", "availability", "effectiveAt"], "properties": {"regionId": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "cpu": {"$ref": "#/components/schemas/ResourceRange"}, "memory": {"$ref": "#/components/schemas/ResourceRange"}, "disk": {"$ref": "#/components/schemas/ResourceRange"}, "dedicatedIpAvailable": {"type": "boolean"}, "endpointDeliveryModes": {"type": "array", "items": {"type": "string", "enum": ["gateway", "dedicated-ip", "node-direct"]}, "minItems": 1, "uniqueItems": true}, "availability": {"type": "string", "enum": ["available", "limited", "unavailable"]}, "effectiveAt": {"type": "string", "format": "date-time"}}},
      "ResourceRange": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum", "step"], "properties": {"minimum": {"type": "integer", "minimum": 1}, "maximum": {"type": "integer", "minimum": 1}, "step": {"type": "integer", "minimum": 1}}}
    }
  }
}
