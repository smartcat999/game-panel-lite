{
  "openapi": "3.1.0",
  "info": {"title": "GamePanel Control Plane API", "version": "1.0.0"},
  "servers": [{"url": "/api"}],
  "paths": {
    "/v1/auth/github/start": {"post": {"operationId": "startGitHubSignIn", "requestBody": {"$ref": "#/components/requestBodies/GitHubSignInStart"}, "responses": {"200": {"description": "GitHub authorization redirect", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GitHubSignInStartResult"}}}}}}},
    "/v1/auth/github/callback": {"get": {"operationId": "completeGitHubSignIn", "responses": {"302": {"description": "Session established"}}}},
    "/v1/auth/password/sign-in": {"post": {"operationId": "signInWithPassword", "requestBody": {"$ref": "#/components/requestBodies/PasswordSignIn"}, "responses": {"200": {"description": "Session established", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PasswordSignInResult"}}}}}}},
    "/v1/auth/password": {"put": {"operationId": "setLocalPassword", "requestBody": {"$ref": "#/components/requestBodies/SetPassword"}, "responses": {"204": {"description": "OAuth or operator-created user password set after recent reauthentication"}}}},
    "/v1/auth/operator/totp/enroll": {"post": {"operationId": "enrollOperatorTotp", "responses": {"201": {"description": "TOTP secret returned once after recent reauthentication"}}}},
    "/v1/auth/operator/totp/verify": {"post": {"operationId": "verifyOperatorTotp", "requestBody": {"$ref": "#/components/requestBodies/TotpVerification"}, "responses": {"204": {"description": "Operator session rotated and elevated"}}}},
    "/v1/session": {
      "get": {"operationId": "getSession", "responses": {"200": {"description": "Current session", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Session"}}}}}},
      "delete": {"operationId": "signOut", "responses": {"204": {"description": "Session ended"}}}
    },
    "/v1/invitations/{invitationToken}:redeem": {"post": {"operationId": "redeemInvitation", "parameters": [{"$ref": "#/components/parameters/InvitationToken"}], "responses": {"200": {"$ref": "#/components/responses/OK"}}}},
    "/v1/user-preferences": {
      "get": {"operationId": "getUserPreferences", "responses": {"200": {"$ref": "#/components/responses/OK"}}},
      "patch": {"operationId": "updateUserPreferences", "responses": {"200": {"$ref": "#/components/responses/OK"}}}
    },
    "/v1/workspaces": {"get": {"operationId": "listWorkspaces", "responses": {"200": {"$ref": "#/components/responses/OK"}}}},
    "/v1/workspace-selection": {"post": {"operationId": "selectWorkspace", "responses": {"204": {"description": "Workspace selected"}}}},
    "/v1/workspaces/{workspaceId}/members": {"get": {"operationId": "listWorkspaceMembers", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}], "responses": {"200": {"$ref": "#/components/responses/OK"}}}},
    "/v1/workspaces/{workspaceId}/invitations": {"post": {"operationId": "createWorkspaceInvitation", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}], "requestBody": {"$ref": "#/components/requestBodies/CreateWorkspaceInvitation"}, "responses": {"201": {"description": "Single-use invitation created"}}}},
    "/v1/workspaces/{workspaceId}/role-bindings": {"get": {"operationId": "listWorkspaceRoleBindings", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}], "responses": {"200": {"$ref": "#/components/responses/OK"}}}},
    "/v1/regions": {"get": {"operationId": "listRegions", "responses": {"200": {"$ref": "#/components/responses/OK"}}}},
    "/v1/regions/{regionId}/catalog": {"get": {"operationId": "getRegionCatalog", "parameters": [{"$ref": "#/components/parameters/RegionId"}], "responses": {"200": {"description": "Region capacity classes and price book", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RegionCatalog"}}}}}}},
    "/v1/providers/releases": {"get": {"operationId": "listProviderReleases", "responses": {"200": {"description": "Published signed Provider releases", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/ProviderReleaseSummary"}}}}}}}},
    "/v1/providers/releases/{providerReleaseId}/manifest": {"get": {"operationId": "getProviderManifest", "parameters": [{"$ref": "#/components/parameters/ProviderReleaseId"}], "responses": {"200": {"description": "Immutable provider configuration and listener manifest", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderManifest"}}}}}}},
    "/v1/providers/releases/{providerReleaseId}/mods": {"get": {"operationId": "getProviderModCatalog", "parameters": [{"$ref": "#/components/parameters/ProviderReleaseId"}], "responses": {"200": {"description": "Signed exact-version mod catalog", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ModCatalog"}}}}}}},
    "/v1/workspaces/{workspaceId}/wallet": {"get": {"operationId": "getWorkspaceWallet", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}], "responses": {"200": {"description": "Prepaid wallet", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Wallet"}}}}}}},
    "/v1/workspaces/{workspaceId}/ledger-entries": {"get": {"operationId": "listWorkspaceLedgerEntries", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}], "responses": {"200": {"description": "Immutable ledger entries", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/LedgerEntry"}}}}}}}},
    "/v1/workspaces/{workspaceId}/quotes": {"post": {"operationId": "createResourceQuote", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateQuote"}}}}, "responses": {"200": {"description": "Short-lived resource quote", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Quote"}}}}}}},
    "/v1/workspaces/{workspaceId}/instances": {
      "get": {"operationId": "listWorkspaceInstances", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}], "responses": {"200": {"description": "Provider-neutral instance list display model", "content": {"application/json": {"schema": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/InstanceListItem"}}}}}}},
      "post": {"operationId": "createLogicalInstance", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateLogicalInstance"}}}}, "responses": {"202": {"$ref": "#/components/responses/Accepted"}}}
    },
    "/v1/workspaces/{workspaceId}/instances/{logicalInstanceId}": {"get": {"operationId": "getWorkspaceInstance", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/LogicalInstanceId"}], "responses": {"200": {"description": "Logical instance", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InstanceDetail"}}}}}}},
    "/v1/workspaces/{workspaceId}/instances/{logicalInstanceId}:start": {"post": {"operationId": "startLogicalInstance", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/LogicalInstanceId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"202": {"$ref": "#/components/responses/Accepted"}}}},
    "/v1/workspaces/{workspaceId}/instances/{logicalInstanceId}:stop": {"post": {"operationId": "stopLogicalInstance", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/LogicalInstanceId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"202": {"$ref": "#/components/responses/Accepted"}}}},
    "/v1/workspaces/{workspaceId}/instances/{logicalInstanceId}:restart": {"post": {"operationId": "restartLogicalInstance", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/LogicalInstanceId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"202": {"$ref": "#/components/responses/Accepted"}}}},
    "/v1/workspaces/{workspaceId}/instances/{logicalInstanceId}/configuration-drafts": {"post": {"operationId": "createConfigurationDraft", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/LogicalInstanceId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SaveConfigurationDraft"}}}}, "responses": {"201": {"description": "Autosave draft created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConfigurationDraft"}}}}}}},
    "/v1/workspaces/{workspaceId}/instances/{logicalInstanceId}/configuration-drafts/{draftId}": {"put": {"operationId": "saveConfigurationDraft", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/LogicalInstanceId"}, {"name": "draftId", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SaveConfigurationDraft"}}}}, "responses": {"200": {"description": "Draft autosaved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConfigurationDraft"}}}}}}},
    "/v1/workspaces/{workspaceId}/instances/{logicalInstanceId}/configuration-drafts/{draftId}:apply": {"post": {"operationId": "applyConfigurationDraft", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/LogicalInstanceId"}, {"name": "draftId", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"202": {"$ref": "#/components/responses/Accepted"}}}},
    "/v1/workspaces/{workspaceId}/instances/{logicalInstanceId}/revisions/{revisionId}": {"get": {"operationId": "getInstanceRevision", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/LogicalInstanceId"}, {"name": "revisionId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Immutable applied revision", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InstanceRevision"}}}}}}},
    "/v1/workspaces/{workspaceId}/instances/{logicalInstanceId}/logs": {"get": {"operationId": "getInstanceLogs", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/LogicalInstanceId"}], "responses": {"200": {"description": "Instance-keyed log history", "content": {"application/json": {"schema": {"type": "array", "maxItems": 500, "items": {"$ref": "#/components/schemas/InstanceLogEntry"}}}}}}}},
    "/v1/workspaces/{workspaceId}/instances/{logicalInstanceId}/metrics": {"get": {"operationId": "getInstanceMetrics", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/LogicalInstanceId"}], "responses": {"200": {"description": "Instance-keyed metric samples", "content": {"application/json": {"schema": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/components/schemas/InstanceMetricSample"}}}}}}}},
    "/v1/workspaces/{workspaceId}/instances/{logicalInstanceId}/console-commands": {"post": {"operationId": "sendGameConsoleCommand", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/LogicalInstanceId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConsoleCommand"}}}}, "responses": {"202": {"$ref": "#/components/responses/Accepted"}}}},
    "/v1/workspaces/{workspaceId}/backups": {
      "get": {"operationId": "listWorkspaceBackups", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}], "responses": {"200": {"description": "Instance backup records", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/InstanceBackup"}}}}}}},
      "post": {"operationId": "createBackup", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateBackup"}}}}, "responses": {"202": {"$ref": "#/components/responses/Accepted"}}}
    },
    "/v1/workspaces/{workspaceId}/backups/{backupId}:restore": {"post": {"operationId": "restoreBackup", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"name": "backupId", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"202": {"$ref": "#/components/responses/Accepted"}}}},
    "/v1/operations/{operationId}": {"get": {"operationId": "getOperation", "parameters": [{"name": "operationId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Asynchronous operation", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Operation"}}}}}}}
  },
  "components": {
    "parameters": {
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 8, "maxLength": 128}},
      "WorkspaceId": {"name": "workspaceId", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/WorkspaceId"}},
      "LogicalInstanceId": {"name": "logicalInstanceId", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/LogicalInstanceId"}},
      "RegionId": {"name": "regionId", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/RegionId"}},
      "ProviderReleaseId": {"name": "providerReleaseId", "in": "path", "required": true, "schema": {"type": "string"}},
      "InvitationToken": {"name": "invitationToken", "in": "path", "required": true, "schema": {"type": "string"}}
    },
    "requestBodies": {
      "GitHubSignInStart": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["returnPath"], "properties": {"returnPath": {"type": "string", "pattern": "^/[^/].*|^/$"}}}}}},
      "PasswordSignIn": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["username", "password"], "properties": {"username": {"type": "string"}, "password": {"type": "string", "format": "password"}}}}}},
      "SetPassword": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["password"], "properties": {"password": {"type": "string", "format": "password", "minLength": 12}}}}}},
      "TotpVerification": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"type": "string", "pattern": "^[0-9]{6}$"}}}}}},
      "CreateWorkspaceInvitation": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["role"], "properties": {"role": {"type": "string", "enum": ["workspace.owner", "workspace.operator", "workspace.viewer"]}}}}}}
    },
    "responses": {
      "OK": {"description": "Successful response"},
      "Accepted": {"description": "Durable operation accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Operation"}}}}
    },
    "schemas": {
      "UserId": {"type": "string", "pattern": "^usr_[A-Za-z0-9]+$"},
      "GitHubSignInStartResult": {"type": "object", "additionalProperties": false, "required": ["authorizationUrl"], "properties": {"authorizationUrl": {"type": "string", "format": "uri"}}},
      "PasswordSignInResult": {"type": "object", "additionalProperties": false, "required": ["userId", "mustChangePassword"], "properties": {"userId": {"$ref": "#/components/schemas/UserId"}, "mustChangePassword": {"type": "boolean"}}},
      "WorkspaceId": {"type": "string", "pattern": "^ws_[A-Za-z0-9]+$"},
      "LogicalInstanceId": {"type": "string", "pattern": "^lin_[A-Za-z0-9]+$"},
      "RegionId": {"type": "string", "pattern": "^reg_[A-Za-z0-9]+$"},
      "Session": {"type": "object", "additionalProperties": false, "required": ["userId", "expiresAt"], "properties": {"userId": {"$ref": "#/components/schemas/UserId"}, "expiresAt": {"type": "string", "format": "date-time"}, "reauthenticatedAt": {"type": "string", "format": "date-time"}, "operatorVerifiedAt": {"type": "string", "format": "date-time"}}},
      "BuiltInRole": {"type": "string", "enum": ["platform.admin", "region.operator", "workspace.owner", "workspace.operator", "workspace.viewer"]},
      "Action": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$", "examples": ["instance.read", "instance.start", "backup.restore", "wallet.read"]},
      "AuthorizationScope": {"type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": {"type": {"type": "string", "enum": ["platform", "region", "workspace"]}, "id": {"type": "string"}}},
      "RoleBinding": {"type": "object", "additionalProperties": false, "required": ["id", "principalId", "role", "scope"], "properties": {"id": {"type": "string"}, "principalId": {"$ref": "#/components/schemas/UserId"}, "role": {"$ref": "#/components/schemas/BuiltInRole"}, "scope": {"$ref": "#/components/schemas/AuthorizationScope"}}},
      "AuthorizationCheck": {"type": "object", "additionalProperties": false, "required": ["resourceType", "resourceId", "action"], "properties": {"resourceType": {"type": "string"}, "resourceId": {"type": "string"}, "action": {"$ref": "#/components/schemas/Action"}}},
      "AuthorizationBatchRequest": {"type": "object", "additionalProperties": false, "required": ["checks"], "properties": {"checks": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/components/schemas/AuthorizationCheck"}}}},
      "AuthorizationBatchResult": {"type": "object", "additionalProperties": false, "required": ["resourceType", "resourceId", "action", "allowed"], "properties": {"resourceType": {"type": "string"}, "resourceId": {"type": "string"}, "action": {"$ref": "#/components/schemas/Action"}, "allowed": {"type": "boolean"}, "reason": {"type": "string"}}},
      "Operation": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "resourceType", "resourceId", "status", "steps", "createdAt"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "resourceType": {"type": "string"}, "resourceId": {"type": "string"}, "status": {"type": "string", "enum": ["queued", "running", "succeeded", "failed", "cancelled"]}, "steps": {"type": "array", "items": {"$ref": "#/components/schemas/OperationStep"}}, "failureCode": {"type": "string"}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}}},
      "OperationStep": {"type": "object", "additionalProperties": false, "required": ["key", "label", "status"], "properties": {"key": {"type": "string"}, "label": {"type": "string"}, "status": {"type": "string", "enum": ["pending", "running", "succeeded", "failed"]}, "detail": {"type": "string"}}},
      "ResourceSpec": {"type": "object", "additionalProperties": false, "required": ["cpuMilli", "memoryMiB", "diskGiB"], "properties": {"cpuMilli": {"type": "integer", "minimum": 250}, "memoryMiB": {"type": "integer", "minimum": 512}, "diskGiB": {"type": "integer", "minimum": 5}}},
      "RegionCatalog": {"type": "object", "additionalProperties": false, "required": ["regionId", "currency", "resourceBounds", "unitPrices", "capacityState", "endpointDeliveryModes", "dedicatedIpAvailable", "catalogVersion", "priceBookId"], "properties": {"regionId": {"$ref": "#/components/schemas/RegionId"}, "currency": {"const": "CNY"}, "resourceBounds": {"type": "object", "additionalProperties": false, "required": ["cpuMilli", "memoryMiB", "diskGiB"], "properties": {"cpuMilli": {"$ref": "#/components/schemas/ResourceRange"}, "memoryMiB": {"$ref": "#/components/schemas/ResourceRange"}, "diskGiB": {"$ref": "#/components/schemas/ResourceRange"}}}, "unitPrices": {"type": "array", "items": {"$ref": "#/components/schemas/UnitPrice"}}, "capacityState": {"type": "string", "enum": ["available", "limited", "unavailable"]}, "endpointDeliveryModes": {"type": "array", "items": {"type": "string", "enum": ["gateway", "dedicated-ip", "node-direct"]}, "uniqueItems": true}, "dedicatedIpAvailable": {"type": "boolean"}, "catalogVersion": {"type": "integer", "minimum": 1}, "priceBookId": {"type": "string"}}},
      "ResourceRange": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum", "step"], "properties": {"minimum": {"type": "integer", "minimum": 1}, "maximum": {"type": "integer", "minimum": 1}, "step": {"type": "integer", "minimum": 1}}},
      "PriceBook": {"type": "object", "additionalProperties": false, "required": ["id", "regionId", "revision", "currency", "unitPrices", "effectiveAt"], "properties": {"id": {"type": "string"}, "regionId": {"$ref": "#/components/schemas/RegionId"}, "revision": {"type": "integer", "minimum": 1}, "currency": {"const": "CNY"}, "unitPrices": {"type": "array", "items": {"$ref": "#/components/schemas/UnitPrice"}}, "effectiveAt": {"type": "string", "format": "date-time"}}},
      "UnitPrice": {"type": "object", "additionalProperties": false, "required": ["resourceKind", "priceMinor", "unitQuantity", "unit"], "properties": {"resourceKind": {"type": "string", "enum": ["cpu", "memory", "instance-disk", "backup-storage", "dedicated-ip"]}, "priceMinor": {"type": "integer", "minimum": 0}, "unitQuantity": {"type": "integer", "minimum": 1}, "unit": {"type": "string"}}},
      "Wallet": {"type": "object", "additionalProperties": false, "required": ["workspaceId", "currency", "availableMinor", "ledgerSequence", "state"], "properties": {"workspaceId": {"$ref": "#/components/schemas/WorkspaceId"}, "currency": {"const": "CNY"}, "availableMinor": {"type": "integer"}, "ledgerSequence": {"type": "integer", "minimum": 0}, "state": {"type": "string", "enum": ["active", "exhausted", "suspended"]}}},
      "LedgerEntry": {"type": "object", "additionalProperties": false, "required": ["id", "workspaceId", "sequence", "kind", "bucket", "amountMinor", "sourceId", "reason", "occurredAt"], "properties": {"id": {"type": "string"}, "workspaceId": {"$ref": "#/components/schemas/WorkspaceId"}, "sequence": {"type": "integer", "minimum": 1}, "kind": {"type": "string", "enum": ["promotional-credit", "usage-debit", "correction"]}, "bucket": {"type": "string", "enum": ["promotional", "cash"]}, "amountMinor": {"type": "integer"}, "sourceId": {"type": "string"}, "reason": {"type": "string"}, "occurredAt": {"type": "string", "format": "date-time"}}},
      "UsageRecord": {"type": "object", "additionalProperties": false, "required": ["id", "workspaceId", "logicalInstanceId", "regionId", "resourceKind", "quantity", "intervalStart", "intervalEnd", "priceBookId"], "properties": {"id": {"type": "string"}, "workspaceId": {"$ref": "#/components/schemas/WorkspaceId"}, "logicalInstanceId": {"$ref": "#/components/schemas/LogicalInstanceId"}, "regionId": {"$ref": "#/components/schemas/RegionId"}, "resourceKind": {"type": "string"}, "quantity": {"type": "integer", "minimum": 0}, "intervalStart": {"type": "string", "format": "date-time"}, "intervalEnd": {"type": "string", "format": "date-time"}, "priceBookId": {"type": "string"}}},
      "CapacityHold": {"type": "object", "additionalProperties": false, "required": ["id", "workspaceId", "regionId", "resourceSpec", "status", "expiresAt"], "properties": {"id": {"type": "string"}, "workspaceId": {"$ref": "#/components/schemas/WorkspaceId"}, "regionId": {"$ref": "#/components/schemas/RegionId"}, "resourceSpec": {"$ref": "#/components/schemas/ResourceSpec"}, "status": {"type": "string", "enum": ["held", "consumed", "released", "expired"]}, "expiresAt": {"type": "string", "format": "date-time"}}},
      "FundingAuthorization": {"type": "object", "additionalProperties": false, "required": ["id", "workspaceId", "quoteId", "maximumDebitMinor", "currency", "expiresAt", "signature"], "properties": {"id": {"type": "string"}, "workspaceId": {"$ref": "#/components/schemas/WorkspaceId"}, "quoteId": {"type": "string"}, "maximumDebitMinor": {"type": "integer", "minimum": 0}, "currency": {"const": "CNY"}, "expiresAt": {"type": "string", "format": "date-time"}, "signature": {"type": "string", "minLength": 16}}},
      "CreateQuote": {"type": "object", "additionalProperties": false, "required": ["regionId", "providerReleaseId", "resourceSpec"], "properties": {"regionId": {"$ref": "#/components/schemas/RegionId"}, "providerReleaseId": {"type": "string"}, "resourceSpec": {"$ref": "#/components/schemas/ResourceSpec"}}},
      "Quote": {"type": "object", "additionalProperties": false, "required": ["id", "workspaceId", "regionId", "priceBookId", "resourceSpec", "currency", "estimatedHourlyMinor", "expiresAt"], "properties": {"id": {"type": "string"}, "workspaceId": {"$ref": "#/components/schemas/WorkspaceId"}, "regionId": {"$ref": "#/components/schemas/RegionId"}, "priceBookId": {"type": "string"}, "resourceSpec": {"$ref": "#/components/schemas/ResourceSpec"}, "currency": {"const": "CNY"}, "estimatedHourlyMinor": {"type": "integer", "minimum": 0}, "expiresAt": {"type": "string", "format": "date-time"}}},
      "CreateLogicalInstance": {"type": "object", "additionalProperties": false, "required": ["name", "regionId", "providerReleaseId", "gameVersion", "resourceSpec", "configuration", "modSelections", "quoteId"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 80}, "regionId": {"$ref": "#/components/schemas/RegionId"}, "providerReleaseId": {"type": "string"}, "gameVersion": {"type": "string"}, "resourceSpec": {"$ref": "#/components/schemas/ResourceSpec"}, "configuration": {"type": "object"}, "modSelections": {"type": "array", "items": {"$ref": "#/components/schemas/ModSelection"}, "uniqueItems": true}, "quoteId": {"type": "string"}}},
      "EndpointBinding": {"type": "object", "additionalProperties": false, "required": ["name", "purpose", "address", "transports", "stability", "displayAddress", "primary"], "properties": {"name": {"type": "string"}, "purpose": {"type": "string"}, "address": {"type": "string"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "transports": {"type": "array", "items": {"type": "string", "enum": ["tcp", "udp"]}, "minItems": 1, "uniqueItems": true}, "stability": {"type": "string", "enum": ["stable", "may-change"]}, "displayAddress": {"type": "string"}, "primary": {"type": "boolean"}}},
      "InstanceListGame": {"type": "object", "additionalProperties": false, "required": ["providerReleaseId", "key", "displayName", "version"], "properties": {"providerReleaseId": {"type": "string"}, "key": {"type": "string"}, "displayName": {"type": "string"}, "version": {"type": "string"}}},
