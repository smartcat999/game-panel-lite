{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamepanel.dev/contracts/events/v1/deployment-desired.schema.json",
  "title": "deployment.desired.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messageId", "messageType", "occurredAt", "idempotencyKey", "payload"],
  "properties": {
    "schemaVersion": {"const": "v1"},
    "messageId": {"type": "string", "pattern": "^msg_[A-Za-z0-9]+$"},
    "messageType": {"const": "deployment.desired.v1"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "idempotencyKey": {"type": "string", "minLength": 8, "maxLength": 128},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["workspaceId", "logicalInstanceId", "regionId", "placementVersion", "instanceRevisionId", "operationId", "desiredState", "providerReleaseId", "gameVersion", "applyBehavior", "resourceSpec", "configuration", "modLock", "listenerRequirements", "authorityGrant"],
      "properties": {
        "workspaceId": {"type": "string"}, "logicalInstanceId": {"type": "string"}, "regionId": {"type": "string"},
        "placementVersion": {"type": "integer", "minimum": 1}, "instanceRevisionId": {"type": "string"}, "operationId": {"type": "string"},
        "desiredState": {"type": "string", "enum": ["running", "stopped", "deleted"]}, "providerReleaseId": {"type": "string"}, "gameVersion": {"type": "string"},
        "applyBehavior": {"type": "string", "enum": ["hot-reload", "restart-required", "recreate-required"]},
        "resourceSpec": {"$ref": "#/$defs/resourceSpec"}, "configuration": {"type": "object"}, "modLock": {"type": "array", "items": {"$ref": "#/$defs/modLockEntry"}},
        "listenerRequirements": {"type": "array", "items": {"$ref": "#/$defs/listenerRequirement"}, "minItems": 1},
        "secretReferences": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "authorityGrant": {"$ref": "#/$defs/authorityGrant"}
      }
    }
  },
  "$defs": {
    "resourceSpec": {"type": "object", "additionalProperties": false, "required": ["cpuMilli", "memoryMiB", "diskGiB"], "properties": {"cpuMilli": {"type": "integer", "minimum": 1}, "memoryMiB": {"type": "integer", "minimum": 1}, "diskGiB": {"type": "integer", "minimum": 1}}},
    "listenerRequirement": {"type": "object", "additionalProperties": false, "required": ["name", "purpose", "transports", "internalPort", "externalPortPolicy", "addressMode", "primary"], "properties": {
      "name": {"type": "string"}, "purpose": {"type": "string"}, "transports": {"type": "array", "items": {"type": "string", "enum": ["tcp", "udp"]}, "minItems": 1, "uniqueItems": true},
      "internalPort": {"type": "integer", "minimum": 1, "maximum": 65535}, "externalPortPolicy": {"type": "string", "enum": ["allocated", "default-required"]},
      "addressMode": {"type": "string", "enum": ["ip-port", "ip-only"]}, "primary": {"type": "boolean"}
    }},
    "modLockEntry": {"type": "object", "additionalProperties": false, "required": ["modId", "version", "digest", "direct"], "properties": {"modId": {"type": "string"}, "version": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "direct": {"type": "boolean"}}},
    "authorityGrant": {"type": "object", "additionalProperties": false, "required": ["issuer", "action", "regionId", "placementVersion", "expiresAt", "signature"], "properties": {
      "issuer": {"const": "control-plane"}, "action": {"const": "deployment.reconcile"}, "regionId": {"type": "string"},
      "placementVersion": {"type": "integer", "minimum": 1}, "expiresAt": {"type": "string", "format": "date-time"}, "signature": {"type": "string", "minLength": 16}
    }}
  }
}
