{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamepanel.dev/contracts/events/v1/deployment-desired.schema.json",
  "title": "deployment.desired.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messageId", "messageType", "occurredAt", "idempotencyKey", "payload"],
  "properties": {
    "schemaVersion": {"const": 1},
    "messageId": {"type": "string", "pattern": "^evt_[A-Za-z0-9]+$"},
    "messageType": {"const": "deployment.desired.v1"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "idempotencyKey": {"type": "string", "minLength": 8, "maxLength": 128},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["workspaceId", "logicalInstanceId", "regionId", "placementVersion", "instanceRevisionId", "desiredState", "gameKey", "gameVersion", "configuration", "cpuUnits", "memoryMegabytes"],
      "properties": {
        "workspaceId": {"type": "string", "pattern": "^ws_[A-Za-z0-9]+$"},
        "logicalInstanceId": {"type": "string", "pattern": "^lin_[A-Za-z0-9]+$"},
        "regionId": {"type": "string", "pattern": "^reg_[A-Za-z0-9]+$"},
        "placementVersion": {"type": "integer", "minimum": 1},
        "instanceRevisionId": {"type": "string", "pattern": "^rev_[A-Za-z0-9]+$"},
        "desiredState": {"type": "string", "enum": ["running", "stopped"]},
        "gameKey": {"type": "string", "minLength": 1},
        "gameVersion": {"type": "string", "minLength": 1},
        "configuration": {"type": "object"},
        "cpuUnits": {"type": "integer", "minimum": 1},
        "memoryMegabytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
