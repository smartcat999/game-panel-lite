{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamepanel.dev/contracts/events/v1/backup-requested.schema.json",
  "title": "backup.requested.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messageId", "messageType", "occurredAt", "idempotencyKey", "payload"],
  "properties": {
    "schemaVersion": {"const": "v1"},
    "messageId": {"type": "string", "pattern": "^msg_[A-Za-z0-9]+$"},
    "messageType": {"const": "backup.requested.v1"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "idempotencyKey": {"type": "string", "minLength": 8, "maxLength": 128},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["workspaceId", "backupRequestId", "operationId", "logicalInstanceId", "regionId", "kind", "objectKey", "transferUrl", "dataScope", "authorityGrant"],
      "properties": {
        "workspaceId": {"type": "string"},
        "backupRequestId": {"type": "string"},
        "operationId": {"type": "string"},
        "logicalInstanceId": {"type": "string"},
        "regionId": {"type": "string"},
        "kind": {"type": "string", "enum": ["backup", "restore"]},
        "objectKey": {"type": "string", "minLength": 1},
        "transferUrl": {"type": "string", "format": "uri"},
        "dataScope": {"const": "instance"},
        "authorityGrant": {"type": "object", "additionalProperties": false, "required": ["issuer", "action", "regionId", "expiresAt", "signature"], "properties": {"issuer": {"const": "control-plane"}, "action": {"const": "backup.execute"}, "regionId": {"type": "string"}, "expiresAt": {"type": "string", "format": "date-time"}, "signature": {"type": "string", "minLength": 32}}}
      }
    }
  }
}
