{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamepanel.dev/contracts/events/v1/backup-observed.schema.json",
  "title": "backup.observed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messageId", "messageType", "occurredAt", "idempotencyKey", "payload"],
  "properties": {
    "schemaVersion": {"const": 1},
    "messageId": {"type": "string", "pattern": "^evt_[A-Za-z0-9]+$"},
    "messageType": {"const": "backup.observed.v1"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "idempotencyKey": {"type": "string", "minLength": 8, "maxLength": 128},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["backupRequestId", "logicalInstanceId", "regionId", "sequence", "status", "observedAt"],
      "properties": {
        "backupRequestId": {"type": "string", "pattern": "^bkr_[A-Za-z0-9]+$"},
        "logicalInstanceId": {"type": "string", "pattern": "^lin_[A-Za-z0-9]+$"},
        "regionId": {"type": "string", "pattern": "^reg_[A-Za-z0-9]+$"},
        "sequence": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "enum": ["queued", "running", "completed", "failed"]},
        "observedAt": {"type": "string", "format": "date-time"},
        "objectKey": {"type": "string"},
        "sizeBytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
