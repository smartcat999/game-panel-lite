{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamepanel.dev/contracts/events/v1/console-command-requested.schema.json",
  "title": "console.command.requested.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messageId", "messageType", "occurredAt", "idempotencyKey", "payload"],
  "properties": {
    "schemaVersion": {"const": "v1"},
    "messageId": {"type": "string", "pattern": "^msg_[A-Za-z0-9]+$"},
    "messageType": {"const": "console.command.requested.v1"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "idempotencyKey": {"type": "string", "minLength": 8, "maxLength": 128},
    "payload": {"type": "object", "additionalProperties": false, "required": ["workspaceId", "logicalInstanceId", "regionId", "operationId", "command", "authorityGrant"], "properties": {
      "workspaceId": {"type": "string"}, "logicalInstanceId": {"type": "string"}, "regionId": {"type": "string"}, "operationId": {"type": "string"}, "command": {"type": "string", "minLength": 1, "maxLength": 4096},
      "authorityGrant": {"type": "object", "additionalProperties": false, "required": ["issuer", "action", "regionId", "expiresAt", "signature"], "properties": {"issuer": {"const": "control-plane"}, "action": {"const": "console.execute"}, "regionId": {"type": "string"}, "expiresAt": {"type": "string", "format": "date-time"}, "signature": {"type": "string", "minLength": 32}}}
    }}
  }
}
