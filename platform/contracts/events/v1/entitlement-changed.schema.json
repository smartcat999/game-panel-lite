{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamepanel.dev/contracts/events/v1/entitlement-changed.schema.json",
  "title": "entitlement.changed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messageId", "messageType", "occurredAt", "idempotencyKey", "payload"],
  "properties": {
    "schemaVersion": {"const": 1},
    "messageId": {"type": "string", "pattern": "^evt_[A-Za-z0-9]+$"},
    "messageType": {"const": "entitlement.changed.v1"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "idempotencyKey": {"type": "string", "minLength": 8, "maxLength": 128},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["workspaceId", "logicalInstanceId", "entitlementId", "status", "effectiveAt", "expiresAt"],
      "properties": {
        "workspaceId": {"type": "string", "pattern": "^ws_[A-Za-z0-9]+$"},
        "logicalInstanceId": {"type": "string", "pattern": "^lin_[A-Za-z0-9]+$"},
        "entitlementId": {"type": "string", "pattern": "^ent_[A-Za-z0-9]+$"},
        "status": {"type": "string", "enum": ["active", "expired", "revoked"]},
        "effectiveAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
