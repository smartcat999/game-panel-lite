{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamepanel.dev/contracts/events/v1/instance-action-observed.schema.json",
  "title": "instance.action.observed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messageId", "messageType", "occurredAt", "idempotencyKey", "payload"],
  "properties": {
    "schemaVersion": {"const": "v1"},
    "messageId": {"type": "string", "pattern": "^msg_[A-Za-z0-9]+$"},
    "messageType": {"const": "instance.action.observed.v1"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "idempotencyKey": {"type": "string", "minLength": 8, "maxLength": 128},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "operationId", "logicalInstanceId", "regionId", "kind", "status", "observedAt"],
      "properties": {
        "workspaceId": {"type": "string", "minLength": 1},
        "operationId": {"type": "string", "minLength": 1},
        "logicalInstanceId": {"type": "string", "pattern": "^lin_[A-Za-z0-9]+$"},
        "regionId": {"type": "string", "pattern": "^reg_[A-Za-z0-9]+$"},
        "kind": {"enum": ["console", "restore"]},
        "status": {"enum": ["completed", "failed"]},
        "failureCode": {"type": "string"},
        "observedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
