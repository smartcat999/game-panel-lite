{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://gamepanel.dev/contracts/events/v1/deployment-observed.schema.json", "title": "deployment.observed.v1",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "messageId", "messageType", "occurredAt", "idempotencyKey", "payload"],
  "properties": {
    "schemaVersion": {"const": "v1"}, "messageId": {"type": "string"}, "messageType": {"const": "deployment.observed.v1"}, "occurredAt": {"type": "string", "format": "date-time"}, "idempotencyKey": {"type": "string", "minLength": 8},
    "payload": {"type": "object", "additionalProperties": false, "required": ["workspaceId", "logicalInstanceId", "regionalDeploymentId", "runtimeAttemptId", "regionId", "placementVersion", "sequence", "observedState", "endpointBindings", "observedAt"], "properties": {
      "workspaceId": {"type": "string"}, "logicalInstanceId": {"type": "string"}, "regionalDeploymentId": {"type": "string"}, "runtimeAttemptId": {"type": "string"}, "regionId": {"type": "string"},
      "placementVersion": {"type": "integer", "minimum": 1}, "sequence": {"type": "integer", "minimum": 0}, "observedState": {"type": "string", "enum": ["pending", "starting", "running", "stopping", "stopped", "failed", "unknown", "deleted"]},
      "endpointBindings": {"type": "array", "items": {"$ref": "#/$defs/endpointBinding"}},
      "reasonCode": {"type": "string"}, "observedAt": {"type": "string", "format": "date-time"}
    }}
  },
  "$defs": {
    "endpointBinding": {"type": "object", "additionalProperties": false, "required": ["name", "purpose", "address", "transports", "stability", "displayAddress", "primary"], "properties": {
      "name": {"type": "string"}, "purpose": {"type": "string"}, "address": {"type": "string"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535},
      "transports": {"type": "array", "items": {"type": "string", "enum": ["tcp", "udp"]}, "minItems": 1, "uniqueItems": true},
      "stability": {"type": "string", "enum": ["stable", "may-change"]}, "displayAddress": {"type": "string"}, "primary": {"type": "boolean"}
    }}
  }
}
