{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamepanel.dev/contracts/events/v1/instance-observed.schema.json",
  "title": "instance.telemetry.observed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messageId", "messageType", "occurredAt", "idempotencyKey", "payload"],
  "properties": {
    "schemaVersion": {"const": "v1"},
    "messageId": {"type": "string", "pattern": "^msg_[A-Za-z0-9]+$"},
    "messageType": {"const": "instance.telemetry.observed.v1"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "idempotencyKey": {"type": "string", "minLength": 8, "maxLength": 128},
    "payload": {"type": "object", "additionalProperties": false, "required": ["workspaceId", "logicalInstanceId", "regionId", "regionalDeploymentId", "runtimeAttemptId", "fencingToken", "sequence", "logs", "metrics", "observedAt"], "properties": {
      "workspaceId": {"type": "string"}, "logicalInstanceId": {"type": "string"}, "regionId": {"type": "string"}, "regionalDeploymentId": {"type": "string"}, "runtimeAttemptId": {"type": "string"}, "fencingToken": {"type": "integer", "minimum": 1}, "sequence": {"type": "integer", "minimum": 1},
      "logs": {"type": "array", "maxItems": 500, "items": {"type": "object", "additionalProperties": false, "required": ["id", "stream", "message", "observedAt"], "properties": {"id": {"type": "string"}, "stream": {"type": "string", "enum": ["stdout", "stderr", "console", "system"]}, "message": {"type": "string", "maxLength": 16384}, "observedAt": {"type": "string", "format": "date-time"}}}},
      "metrics": {"type": "array", "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["id", "metric", "value", "unit", "source", "sampledAt"], "properties": {"id": {"type": "string"}, "metric": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string"}, "source": {"type": "string", "enum": ["platform", "provider-api", "log-parser"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "freshUntil": {"type": "string", "format": "date-time"}, "sampledAt": {"type": "string", "format": "date-time"}}}},
      "observedAt": {"type": "string", "format": "date-time"}
    }}
  }
}
